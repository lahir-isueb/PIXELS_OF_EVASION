        player_life_rect = player_life_text.get_rect(center=(player_x*SCALED_WIDTH, player_y*SCALED_HEIGHT))
        screen.blit(player_life_text, player_life_rect)

    if player2_alive:
        if players == 2:
            player2_life_text = player2_font.render(str(player2_lives), True, player_skins[p2_skin_color][skin_match])
            player2_life_rect = player2_life_text.get_rect(center=(player2_x*SCALED_WIDTH, player2_y*SCALED_HEIGHT))
            screen.blit(player2_life_text, player2_life_rect)

    if player_frozen and player_alive:
        screen.blit(
            frost_overlay,
            ((player_x*SCALED_WIDTH - frost_overlay.get_width() / 2),
             (player_y*SCALED_HEIGHT - frost_overlay.get_height() / 2))
        )
    if player2_frozen and players == 2 and player2_alive:
        screen.blit(
            frost_overlay,
            ((player2_x*SCALED_WIDTH - frost_overlay.get_width() / 2),
             (player2_y*SCALED_HEIGHT - frost_overlay.get_height() / 2))
        )

    if player_burnt and player_alive:
        screen.blit(
            burn_overlay,
            ((player_x*SCALED_WIDTH - burn_overlay.get_width() / 2),
             (player_y*SCALED_HEIGHT - burn_overlay.get_height() / 2))
        )
    if player2_burnt and players == 2 and player2_alive:
        screen.blit(
            burn_overlay,
            ((player2_x*SCALED_WIDTH - burn_overlay.get_width() / 2),
             (player2_y*SCALED_HEIGHT - burn_overlay.get_height() / 2))
        )

    # draw HUD
    if players == 1:
        p1_text = font.render(f"Score: {score_p1}", True, player_skins[p1_skin_color][0])
        screen.blit(p1_text, (20*SCALED_TEXT, 20*SCALED_TEXT))
    elif players == 2:
        p1_text = font.render(f"P1 Score: {score_p1}", True, player_skins[p1_skin_color][0])
        screen.blit(p1_text, (20*SCALED_TEXT, 20*SCALED_TEXT))
        p2_text = font.render(f"P2 Score: {score_p2}", True, player_skins[p2_skin_color][0])
        screen.blit(p2_text, (20*SCALED_TEXT, 60*SCALED_TEXT))

        
    if paused == False:
        if player_alive and score + p1_xtra_score >= p1_regen_block_until and player_lives < player_health_setting and regen_delay != 6969:
            player_lives += 1
            heal_flash_time = current_time
            p1_regen_block_until = score + p1_xtra_score + regen_delay

        if players == 2 and player2_alive and score + p2_xtra_score >= p2_regen_block_until and player2_lives < player_health_setting and regen_delay != 6969:
            player2_lives += 1
            player2_heal_flash_time = current_time
            p2_regen_block_until = score + p2_xtra_score + regen_delay

        if not player_alive and death_explosion == 0:
            for i in range(16):  # fire 8 projectiles in all directions
                ang = i * (2 * math.pi / 16)
                dxp = math.cos(ang) * 5
                dyp = math.sin(ang) * 5
                projectiles.append({
                    "x": player_x + projectile_size/2,
                    "y": player_y + projectile_size/2,
                    "dx": dxp,
                    "dy": dyp,
                    "color": player_skins[p1_skin_color][0],
                    "ability": None
                })
                death_explosion = 1

        if players == 2 and not player2_alive and p2_death_explosion == 0:
            for i in range(16):  # fire 8 projectiles in all directions
                ang = i * (2 * math.pi / 16)
                dxp = math.cos(ang) * 5
                dyp = math.sin(ang) * 5
                projectiles.append({
                    "x": player2_x + projectile_size/2,
                    "y": player2_y + projectile_size/2,
                    "dx": dxp,
                    "dy": dyp,
                    "color": player_skins[p2_skin_color][0],
                    "ability": None
                })
                p2_death_explosion = 1

    if not player_alive and (players == 1 or not player2_alive) and everyone_died_at == 0:
        everyone_died_at = current_time + 3000

    if (players == 1 and not player_alive) or (players == 2 and not player_alive and not player2_alive):
        game_speed = max(game_speed * 0.98, 0.0001)

    if paused == False:
        cold_until -= (60 / FPS) * game_speed
        player2_cold_until -= (60 / FPS) * game_speed
        hot_until -= (60 / FPS) * game_speed
        player2_hot_until -= (60 / FPS) * game_speed

    targeting_flash += (60 / FPS) * game_speed * 0.015
    if targeting_flash >= 0.75: targeting_flash = 0

    if paused == False:
        weather_timer += (60 / FPS) * game_speed
        storm_timer += (60 / FPS) * game_speed
        
        if spawn_enabled == True:
            if weathers[weather] == "Rain" or weathers[weather] == "Heavy Rain" or weathers[weather] == "Storm":
                if (weather_timer > 10 and weathers[weather] == "Rain") or (weather_timer > 5 and not weathers[weather] == "Rain"):
                    weather_timer = 0
                    projectiles.append({
                        "x": random.uniform(projectile_size, WIDTH/SCALED_WIDTH),
                        "y": 0,
                        "dx": 0,
                        "dy": 5,
                        "color": colorblind_list[colorblind] if colorblind != 0 else BLUE,
                        "ability": None
                    })
                    
            if weathers[weather] == "Lagstorm":
                if weather_timer > 10:
                    weather_timer = 0
                    lagstorm_random = random.uniform(projectile_size, WIDTH/SCALED_WIDTH)
                    projectiles.append({
                        "x": lagstorm_random,
                        "y": 0,
                        "dx": 0,
                        "dy": 5,
                        "color": colorblind_list[colorblind] if colorblind != 0 else LILAC,
                        "ability": "lag",
                        "lag x": lagstorm_random,
                        "lag y": 0,
                        "lag show": 0
                    })

            if weathers[weather] == "Storm":
                if storm_timer > 250:
                    storm_timer = 0
                    stormx = random.uniform(projectile_size, WIDTH/SCALED_WIDTH)
                    for i in range(32):
                        projectiles.append({
                            "x": stormx,
                            "y": 0,
                            "dx": random.uniform(-2, 2),
                            "dy": random.uniform(10, 15),
                            "color": colorblind_list[colorblind] if colorblind != 0 else YELLOW,
                            "ability": None
                        })

            if weathers[weather] == "Snow" or weathers[weather] == "Blizzard":
                if (weather_timer > 10 and weathers[weather] == "Snow") or (weather_timer > 1 and weathers[weather] == "Blizzard"):
                    weather_timer = 0
                    projectiles.append({
                        "x": random.uniform(projectile_size, WIDTH/SCALED_WIDTH),
                        "y": 0,
                        "dx": 0,
                        "dy": 5,
                        "color": colorblind_list[colorblind] if colorblind != 0 else TUNDRA,
                        "ability": "freeze"
                    })

            if weathers[weather] == "Windy":
                if weather_timer > 10:
                    weather_timer = 0
                    projectiles.append({
                        "x": (1920/2) - sandstorm_direction * (1920/2),
                        "y": random.uniform(projectile_size, HEIGHT/SCALED_HEIGHT),
                        "dx": 5*sandstorm_direction,
                        "dy": 0,
                        "color": colorblind_list[colorblind] if colorblind != 0 else CLOUD,
                        "ability": None
                    })
            
            if weathers[weather] == "Sandstorm":
                if weather_timer > 6:
                    weather_timer = 0
                    projectiles.append({
                        "x": (1920/2) - sandstorm_direction * (1920/2),
                        "y": random.uniform(projectile_size, HEIGHT/SCALED_HEIGHT),
                        "dx": 5*sandstorm_direction,
                        "dy": 0,
                        "color": colorblind_list[colorblind] if colorblind != 0 else TAN,
                        "ability": None
                    })

            if weathers[weather] == "Blood Rain":
                if weather_timer > 12:
                    weather_timer = 0
                    projectiles.append({
                        "x": random.uniform(projectile_size, WIDTH/SCALED_WIDTH),
                        "y": 0,
                        "dx": 0,
                        "dy": 5,
                        "color": colorblind_list[colorblind] if colorblind != 0 else RED,
                        "ability": "fatal"
                    })
                    
    if paused == False and spawn_enabled == True:
        spawner_timer += (60 / FPS) * game_speed * 12

    for enemy in enemies:
        controlpoint_surface = pygame.Surface((enemy["size"]*SCALED_WIDTH, enemy["size"]*SCALED_HEIGHT), pygame.SRCALPHA)
        controlpoint_surface.fill((spawner_color[0], spawner_color[1], spawner_color[2], 100))
        if enemy["type"] == 6767: screen.blit(controlpoint_surface, ((enemy["x"] - enemy["size"] / 2)*SCALED_WIDTH, (enemy["y"] - enemy["size"] / 2)* SCALED_HEIGHT))

    if paused == True:
        pause_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        pause_overlay.fill((0, 0, 0, 180))
        screen.blit(
            pause_overlay,
            (0,
            0)
        )
        pause_text = font.render("Paused", True, spawner_color)
        screen.blit(pause_text, (WIDTH - 120*SCALED_TEXT, 20*SCALED_TEXT))
        pause_message_text = biggish_font.render("Press p to resume.", True, spawner_color)
        screen.blit(pause_message_text, (WIDTH/2-220*SCALED_TEXT, HEIGHT/2-45*SCALED_TEXT))
        pause_message_text = biggish_font.render("Press escape to exit.", True, spawner_color)
        screen.blit(pause_message_text, (WIDTH/2-240*SCALED_TEXT, HEIGHT/2+25*SCALED_TEXT))

    if current_time > everyone_died_at and everyone_died_at != 0:
        result = GAME_OVER(truescore, score_p1, score_p2)
        if result == "TITLE":
            TITLE_SCREEN()
            continue
        running = False
        break
    
    pygame.display.flip()

pygame.quit()
